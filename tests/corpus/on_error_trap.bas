10 REM Trap errors with ON ERROR, ERR, ERL and REPORT
20 COUNT% = 0
30 ON ERROR GOTO 200
40 READ D
50 IF D = -1 THEN 100
60 PRINT "100 / ";D;" = ";100 / D
70 GOTO 40
100 PRINT "Errors: ";COUNT%
110 ON ERROR OFF
120 END
200 COUNT% = COUNT% + 1
210 PRINT "Error ";ERR;" at line ";ERL;": ";
220 REPORT
230 PRINT
240 GOTO 40
250 DATA 4, 0, 8, 0, -1
