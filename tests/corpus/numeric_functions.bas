10 REM Numeric functions with no brackets
20 R = 10
30 AREA = PI * R ^ 2
40 PRINT "Area: ";INT AREA
50 PRINT "Root of 144: ";SQR 144
60 PRINT "Hypotenuse: ";SQR(3 ^ 2 + 4 ^ 2)
70 PRINT "ABS -7: ";ABS -7
80 PRINT "SGN: ";SGN -3;" ";SGN 0;" ";SGN 9
90 PRINT "INT -2.5: ";INT -2.5
100 PRINT "Degrees in a right angle: ";DEG (PI / 2)
110 PRINT "SIN 30 degrees: ";INT(SIN RAD 30 * 1000 + 0.5) / 1000
120 PRINT "LOG 1000: ";LOG 1000
130 PRINT "LN EXP 2: ";LN EXP 2
140 X = -3.7
150 PRINT "INT X + 1: ";INT X + 1
160 PRINT "Rounded: ";INT(X + 0.5)
170 DEF FNsq(N) = N * N
180 PRINT "FNsq 3 is ";FNsq(3)
