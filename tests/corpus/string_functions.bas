10 REM String work with LEFT$, MID$, RIGHT$ and INSTR
20 S$ = "THE QUICK BROWN FOX"
30 PRINT LEFT$(S$,3)
40 PRINT RIGHT$(S$,3)
50 PRINT MID$(S$,5,5)
60 PRINT MID$(S$,11)
70 PRINT ;INSTR(S$,"BROWN")
80 PRINT ;INSTR(S$,"O",14)
90 PRINT ;INSTR(S$,"Z")
100 R$ = ""
110 FOR I% = LEN S$ TO 1 STEP -1
120   R$ = R$ + MID$(S$,I%,1)
130 NEXT I%
140 PRINT R$
150 V% = 0
160 FOR I% = 1 TO LEN S$
170   IF INSTR("AEIOU",MID$(S$,I%,1)) > 0 THEN V% = V% + 1
180 NEXT I%
190 PRINT "Vowels: ";V%
200 PRINT ;LEN S$
210 PRINT ;ASC S$
220 PRINT CHR$ 65 + CHR$ 66
230 N$ = STR$ 42
240 PRINT N$ + "!"
250 PRINT ;VAL "12" + 3
260 PRINT STRING$(3,"AB")
270 L$ = "hello"
280 U$ = ""
290 FOR I% = 1 TO LEN L$
300   C% = ASC MID$(L$,I%,1)
310   IF C% >= 97 AND C% <= 122 THEN C% = C% - 32
320   U$ = U$ + CHR$ C%
330 NEXT I%
340 PRINT U$
